# Ignore credentials and sensitive files
.env
.env.local
.env.*.local

# Ignore uploaded files (user content)
uploads/*
!uploads/.gitkeep

# Ignore PHP error logs
error_log
*.log

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore Node modules (kontum-evoucher folder)
node_modules/

# Ignore IDE settings
.vscode/
.idea/
*.swp
*.swo

# Ignore storage cache & rate limits
storage/rate_limits/
storage/cache/
storage/logs/

# Ignore vendor & zip packages
vendor/
*.zip

# Temporary test files
test_socket_result.json
